{
  "manifest_version": 3,
  "name": "The Stickiest Notes - Never Miss What Matters",
  "version": "3.6",
  "description": "Capture notes, quotes, links, and tasks while browsing, then organize them by site, category, tags, and favorites.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "poza.png",
      "32": "poza.png",
      "48": "poza.png",
      "128": "poza.png"
    }
  },
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "poza.png",
    "32": "poza.png",
    "48": "poza.png",
    "128": "poza.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "windows",
    "sidePanel",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "style.css", "script.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Open Sticky Notes"
    }
  }
}